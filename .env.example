# Everything here is OPTIONAL. With no variables set, the app runs in
# local demo mode (localStorage + BroadcastChannel, pre-seeded data).

# --- Supabase (free tier) for cross-device realtime sync ---
# Run supabase/schema.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (free tier) for emailed receipts. Server-side only. ---
RESEND_API_KEY=
# Use onboarding@resend.dev until you verify your own domain in Resend.
RECEIPT_FROM_EMAIL=Spice Route <onboarding@resend.dev>

# --- Optional: base URL encoded into table QR codes (e.g. your LAN IP or deployed URL) ---
NEXT_PUBLIC_APP_URL=
